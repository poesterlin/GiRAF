
# --- Integrations ---

# Immich
IMMICH_BASE_URL=https://immich.example.com
IMMICH_API_KEY=your_api_key_here

# Google Photos
# To get these, create a project in Google Cloud Console with Photos Library API enabled.
GOOGLE_CLIENT_ID=your_client_id_here
GOOGLE_CLIENT_SECRET=your_client_secret_here

# Domain for Google OAuth callback. Example http:localhost:4893
HOST_DOMAIN=

# --- Develop base intermediate representation ---
# Full-resolution TIFFs built once per RAW and reused by exports and previews so
# RawTherapee can skip RAW decode and demosaicing on later renders.
# DEVELOP_CACHE_DIR=/app/tmp/develop-cache
# DEVELOP_CACHE_MAX_BYTES=6442450944
# DEVELOP_CACHE_TTL_MS=604800000

# Optional: extra directories to scan, separated by ":"
# IMPORT_EXTRA_DIRS=/mnt/cards:/mnt/nas/raw
