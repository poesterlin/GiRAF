[Version]
AppVersion=5.12
Version=352

[Exposure]
Enabled=true
Auto=true

[White Balance]
Enabled=true
Setting=Camera

[Resize]
Enabled=true
Scale=0.14000000000000001
AppliesTo=Cropped area
Method=Lanczos
DataSpecified=3
Width=1000
Height=1000
LongEdge=1000
ShortEdge=1000
AllowUpscaling=false

# Corrected once while developing the RAW, so previews and exports share the same geometry.
[LensProfile]
LcMode=lfauto
UseDistortion=true
UseVignette=true
UseCA=true
